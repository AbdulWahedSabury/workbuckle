generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(255)
  name      String?  @db.VarChar(120)
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([role])
  @@map("users")
}

model JobCategory {
  id           String                   @id @default(uuid()) @db.Uuid
  slug         String                   @unique @db.VarChar(140)
  imageUrl     String?                  @map("image_url") @db.VarChar(2048)
  imagePath    String?                  @map("image_path") @db.VarChar(1024) // 💡 Added to track the Supabase Storage file reference
  isActive     Boolean                  @default(true) @map("is_active")
  sortOrder    Int                      @default(0) @map("sort_order")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations JobCategoryTranslation[]
  jobs         Job[]

  @@index([isActive, sortOrder])
  @@map("job_categories")
}

model JobCategoryTranslation {
  id         String      @id @default(uuid()) @db.Uuid
  categoryId String      @map("category_id") @db.Uuid
  locale     String      @db.VarChar(10)
  name       String      @db.VarChar(120)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  category   JobCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale, name])
  @@map("job_category_translations")
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  state     String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  jobs      Job[]

  @@index([name])
  @@index([state])
  @@map("cities")
}

model JobType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  jobs      Job[]

  @@map("job_types")
}

model Job {
  id               String      @id @default(uuid()) @db.Uuid
  title            String      @db.VarChar(200)
  salary           String      @db.VarChar(120)
  cityId           String      @map("city_id") @db.Uuid
  jobTypeId        String      @map("type_id") @db.Uuid
  jobCategoryId    String      @map("job_category_id") @db.Uuid
  experience       String      @db.VarChar(120)
  description      String      @db.Text
  responsibilities String      @db.Text
  requirements     String      @db.Text
  benefits         String      @db.Text
  // draft | published | closed — validated in schemas/AdminSchemas.ts.
  status           String      @default("draft") @db.VarChar(20)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Restrict: a city, type or category that jobs still use can't be deleted.
  city             City        @relation(fields: [cityId], references: [id], onDelete: Restrict)
  jobType          JobType     @relation(fields: [jobTypeId], references: [id], onDelete: Restrict)
  jobCategory      JobCategory @relation(fields: [jobCategoryId], references: [id], onDelete: Restrict)
  candidates       Candidate[]

  @@index([cityId])
  @@index([jobTypeId])
  @@index([jobCategoryId])
  @@index([status])
  @@map("jobs")
}

model Candidate {
  id          String   @id @default(cuid())
  firstName   String   @map("first_name") @db.VarChar(120)
  lastName    String   @map("last_name") @db.VarChar(120)
  phone       String   @db.VarChar(40)
  email       String   @db.VarChar(255)
  linkedin    String?  @map("linkedin_url") @db.VarChar(2048)
  // Public URL of the CV in Supabase Storage; cvPath is the object key used to remove it.
  cvUrl       String   @map("cv_url") @db.VarChar(2048)
  cvPath      String?  @map("cv_path") @db.VarChar(1024)
  coverLetter String?  @map("cover_letter") @db.Text
  // pending | rejected | success — validated in schemas/AdminSchemas.ts.
  status      String   @default("pending") @db.VarChar(20)
  jobId       String   @map("job_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Cascade keeps deleteJob working; candidates go with their job.
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@index([createdAt])
  @@map("candidates")
}

model SiteSetting {
  id                 Int      @id @default(1)
  siteName           String   @default("Workbuckle") @map("site_name") @db.VarChar(120)
  contactEmail       String?  @map("contact_email") @db.VarChar(255)
  contactPhone       String?  @map("contact_phone") @db.VarChar(40)
  logoUrl            String?  @map("logo_url") @db.VarChar(2048)
  faviconUrl         String?  @map("favicon_url") @db.VarChar(2048)
  maintenanceMode    Boolean  @default(false) @map("maintenance_mode")
  maintenanceMessage String?  @map("maintenance_message")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

enum Role {
  USER
  ADMIN
}
