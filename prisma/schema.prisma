generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User, Account, Session and VerificationToken follow the Auth.js Prisma
// adapter shape (field names are fixed by @auth/prisma-adapter).
model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique @db.VarChar(255)
  emailVerified     DateTime?          @map("email_verified") @db.Timestamptz(3)
  name              String?            @db.VarChar(120)
  image             String?            @db.VarChar(2048)
  // scrypt hash for the Credentials provider; null for OAuth-only users.
  passwordHash      String?            @map("password_hash") @db.VarChar(255)
  role              Role               @default(USER)
  // EMPLOYER users belong to one client and only see that client's jobs and the
  // applications submitted to it. Null for every other role.
  clientId          String?            @map("client_id") @db.Uuid
  client            Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  accounts          Account[]
  sessions          Session[]
  // Pipeline changes this panel user made (application history).
  applicationEvents ApplicationEvent[]

  @@index([role])
  @@index([clientId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String  @db.VarChar(40)
  provider          String  @db.VarChar(80)
  providerAccountId String  @map("provider_account_id") @db.VarChar(255)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(40)
  scope             String? @db.Text
  id_token          String? @db.Text
  session_state     String? @db.Text
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @db.VarChar(255)
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model JobCategory {
  id           String                   @id @default(uuid()) @db.Uuid
  slug         String                   @unique @db.VarChar(140)
  imageUrl     String?                  @map("image_url") @db.VarChar(2048)
  imagePath    String?                  @map("image_path") @db.VarChar(1024) // 💡 Added to track the Supabase Storage file reference
  icon         String?                  @db.VarChar(64) // Lucide icon name, e.g. "code-xml"
  isActive     Boolean                  @default(true) @map("is_active")
  sortOrder    Int                      @default(0) @map("sort_order")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations JobCategoryTranslation[]
  jobs         Job[]

  @@index([isActive, sortOrder])
  @@map("job_categories")
}

model JobCategoryTranslation {
  id         String      @id @default(uuid()) @db.Uuid
  categoryId String      @map("category_id") @db.Uuid
  locale     String      @db.VarChar(10)
  name       String      @db.VarChar(120)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  category   JobCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale, name])
  @@map("job_category_translations")
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  state     String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  jobs      Job[]

  @@index([name])
  @@index([state])
  @@map("cities")
}

model JobType {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @unique @db.VarChar(120)
  slug         String               @unique @db.VarChar(140)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  jobs         Job[]
  translations JobTypeTranslation[]

  @@map("job_types")
}

// The job type's name in a language other than the default (e.g. Greek).
// English stays on the job_types row and is used when this is missing.
model JobTypeTranslation {
  id        String   @id @default(uuid()) @db.Uuid
  jobTypeId String   @map("job_type_id") @db.Uuid
  locale    String   @db.VarChar(10)
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  jobType   JobType  @relation(fields: [jobTypeId], references: [id], onDelete: Cascade)

  @@unique([jobTypeId, locale])
  @@map("job_type_translations")
}

// A recruiting campaign: a themed group of jobs (e.g. "Front Office & Guest
// Experience") with its own image and intro. Jobs join one from the job form.
model Campaign {
  id           String                @id @default(uuid()) @db.Uuid
  title        String                @db.VarChar(200)
  // Supabase Storage URL, a path under /public (/images/…) or an external URL.
  img          String?               @db.VarChar(2048)
  intro        String                @db.Text
  imageAlt     String?               @map("image_alt") @db.VarChar(255)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  jobs         Job[]
  translations CampaignTranslation[]

  @@index([updatedAt(sort: Desc)])
  @@map("campaigns")
}

// The campaign's text in a language other than the default (e.g. Greek).
// English stays on the campaigns row; a blank field here falls back to it.
model CampaignTranslation {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  locale     String   @db.VarChar(10)
  title      String   @default("") @db.VarChar(200)
  intro      String   @default("") @db.Text
  imageAlt   String   @default("") @map("image_alt") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, locale])
  @@map("campaign_translations")
}

model Client {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(160)
  // The person to talk to at the client, e.g. the hotel's HR manager.
  contactName String?  @map("contact_name") @db.VarChar(160)
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(40)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  jobs        Job[]
  // Client logins (EMPLOYER role).
  users       User[]

  @@index([name])
  @@map("clients")
}

// Question/answer pairs for the public FAQ section (home and contact pages).
model Faq {
  id           String           @id @default(uuid()) @db.Uuid
  question     String           @db.VarChar(300)
  // Plain text; line breaks are kept on the site.
  answer       String           @db.Text
  isActive     Boolean          @default(true) @map("is_active")
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations FaqTranslation[]

  // Public list: WHERE is_active ORDER BY sort_order.
  @@index([isActive, sortOrder])
  @@map("faqs")
}

// The FAQ in a language other than the default (e.g. Greek). English stays on
// the faqs row; a blank field here falls back to it on the site.
model FaqTranslation {
  id        String   @id @default(uuid()) @db.Uuid
  faqId     String   @map("faq_id") @db.Uuid
  locale    String   @db.VarChar(10)
  question  String   @default("") @db.VarChar(300)
  answer    String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  faq       Faq      @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, locale])
  @@map("faq_translations")
}

model Job {
  id               String           @id @default(uuid()) @db.Uuid
  title            String           @db.VarChar(200)
  salary           String           @db.VarChar(120)
  clientId         String           @map("client_id") @db.Uuid
  cityId           String           @map("city_id") @db.Uuid
  jobTypeId        String           @map("type_id") @db.Uuid
  jobCategoryId    String           @map("job_category_id") @db.Uuid
  campaignId       String?          @map("campaign_id") @db.Uuid
  experience       String           @db.VarChar(120)
  // Hiring capacity. Remaining = totalPositions - filledPositions (computed, never stored).
  // filledPositions only changes through the hire action, one per hire.
  totalPositions   Int              @default(1) @map("total_positions")
  filledPositions  Int              @default(0) @map("filled_positions")
  description      String           @db.Text
  responsibilities String           @db.Text
  requirements     String           @db.Text
  benefits         String           @db.Text
  // draft | published | closed — validated in schemas/AdminSchemas.ts.
  status           String           @default("draft") @db.VarChar(20)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // Restrict: a city, type or category that jobs still use can't be deleted.
  city             City             @relation(fields: [cityId], references: [id], onDelete: Restrict)
  jobType          JobType          @relation(fields: [jobTypeId], references: [id], onDelete: Restrict)
  jobCategory      JobCategory      @relation(fields: [jobCategoryId], references: [id], onDelete: Restrict)
  // Optional; deleting a campaign leaves its jobs in place, unassigned.
  campaign         Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  // The role being hired for (Waiter, Bartender, ...). Required by the job form;
  // null only on jobs saved before positions existed. Applicants get it (CandidatePosition).
  positionId       String?          @map("position_id") @db.Uuid
  position         Position?        @relation(fields: [positionId], references: [id], onDelete: Restrict)
  applications     JobApplication[]
  translations     JobTranslation[]
  // CV matching (lib/matching): all-MiniLM-L6-v2 vector of the job's English text,
  // written in the background after every save. Read and written with raw SQL only.
  embedding        Unsupported("vector(384)")?
  embeddedAt       DateTime?        @map("embedded_at") @db.Timestamptz(3)

  @@index([cityId])
  @@index([jobTypeId])
  @@index([jobCategoryId])
  @@index([clientId])
  @@index([campaignId])
  @@index([positionId])
  // Public /jobs list: WHERE status = 'published' ORDER BY created_at DESC.
  // Also serves status-only filters/counts (leftmost prefix), so it replaces @@index([status]).
  @@index([status, createdAt(sort: Desc)])
  // Admin jobs list default order (newest edit first).
  @@index([updatedAt(sort: Desc)])
  @@map("jobs")
}

// The job's text in a language other than the default (e.g. Greek). English
// stays on the jobs row; a blank field here falls back to it on the site.
model JobTranslation {
  id               String   @id @default(uuid()) @db.Uuid
  jobId            String   @map("job_id") @db.Uuid
  locale           String   @db.VarChar(10)
  title            String   @default("") @db.VarChar(200)
  salary           String   @default("") @db.VarChar(120)
  experience       String   @default("") @db.VarChar(120)
  description      String   @default("") @db.Text
  responsibilities String   @default("") @db.Text
  requirements     String   @default("") @db.Text
  benefits         String   @default("") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, locale])
  @@map("job_translations")
}

// A role jobs hire for and candidates are filtered by (Waiter, Bartender, ...).
// Managed by admins like the other catalog lists; admin-only, so no translations.
model Position {
  id         String              @id @default(uuid()) @db.Uuid
  name       String              @db.VarChar(120)
  slug       String              @unique @db.VarChar(140)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Restrict (on Job.position): a position jobs still use can't be deleted.
  jobs       Job[]
  candidates CandidatePosition[]

  @@index([name])
  @@map("positions")
}

/// A person suited for a position. Added when they apply for or are assigned to a
/// job with that position, or set by an admin on their profile.
model CandidatePosition {
  candidateId String    @map("candidate_id") @db.Uuid
  positionId  String    @map("position_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  // Deleting a position removes it from everyone who had it.
  position    Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([candidateId, positionId])
  // Talent pool filter: people with a given position.
  @@index([positionId])
  @@map("candidate_positions")
}

/// A person, one per email address (stored lower-case). Their applications hang off it.
model Candidate {
  id           String              @id @default(uuid()) @db.Uuid
  firstName    String              @map("first_name") @db.VarChar(120)
  lastName     String              @map("last_name") @db.VarChar(120)
  phone        String              @db.VarChar(40)
  email        String              @unique @db.VarChar(255)
  linkedin     String?             @map("linkedin_url") @db.VarChar(2048)
  // The person's own CV, used when an admin assigns them to a job. May be the same
  // storage object as an application's CV, so files are removed only when unused.
  cvUrl        String?             @map("cv_url") @db.VarChar(2048)
  cvPath       String?             @map("cv_path") @db.VarChar(1024)
  // open | hired | inactive — validated in schemas/AdminSchemas.ts.
  // Set to hired only by the hire action; hired candidates can't apply again.
  status       String              @default("open") @db.VarChar(20)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  applications JobApplication[]
  // Positions this person is suited for: from the jobs they applied or were
  // assigned to, plus any an admin set on their profile. Filters the talent pool.
  positions    CandidatePosition[]
  // CV matching (lib/matching), refreshed in the background when cvPath changes.
  // cvText: text extracted from the CV (null if it couldn't be read, e.g. a .doc).
  // embedding: vector of that text, read and written with raw SQL only.
  // embeddedAt: when indexing last ran; null means never, so the backfill picks it up.
  cvText       String?             @map("cv_text") @db.Text
  embedding    Unsupported("vector(384)")?
  embeddedAt   DateTime?           @map("embedded_at") @db.Timestamptz(3)

  @@index([status])
  @@map("candidates")
}

/// One candidate applying for one job. The admin "Candidates" pages list these.
model JobApplication {
  id                       String             @id @default(cuid())
  candidateId              String             @map("candidate_id") @db.Uuid
  jobId                    String             @map("job_id") @db.Uuid
  // Public URL of the CV in Supabase Storage; cvPath is the object key used to remove it.
  cvUrl                    String             @map("cv_url") @db.VarChar(2048)
  cvPath                   String?            @map("cv_path") @db.VarChar(1024)
  coverLetter              String?            @map("cover_letter") @db.Text
  screeningNotes           String?            @map("screening_notes") @db.Text
  clientProfileEmailSentAt DateTime?          @map("client_profile_email_sent_at") @db.Timestamptz(3)
  // First time the application went to the employer (submitted, interview or hired).
  // The client's own users see an application only once this is set.
  submittedAt              DateTime?          @map("submitted_at") @db.Timestamptz(3)
  // pending | under_review | shortlisted | submitted | interview | rejected | hired | cancelled
  // — validated in schemas/AdminSchemas.ts. hired only via the hire action; cancelled is automatic.
  status                   String             @default("pending") @db.VarChar(20)
  // not_scheduled | scheduled | completed | passed | failed | cancelled
  interviewStatus          String             @default("not_scheduled") @map("interview_status") @db.VarChar(20)
  interviewAt              DateTime?          @map("interview_at") @db.Timestamptz(3)
  interviewNotes           String?            @map("interview_notes") @db.Text
  employerFeedback         String?            @map("employer_feedback") @db.Text
  hiredAt                  DateTime?          @map("hired_at") @db.Timestamptz(3)
  // Contact details as typed on applications made before candidates were merged
  // by email (migration 20261111130000). Kept so no data was lost; new rows leave
  // them empty. Drop once the merged candidate records are verified.
  legacyFirstName          String?            @map("first_name") @db.VarChar(120)
  legacyLastName           String?            @map("last_name") @db.VarChar(120)
  legacyPhone              String?            @map("phone") @db.VarChar(40)
  legacyEmail              String?            @map("email") @db.VarChar(255)
  legacyLinkedin           String?            @map("linkedin_url") @db.VarChar(2048)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Deleting the person removes their applications.
  candidate                Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  // Cascade keeps deleteJob working; applications go with their job.
  job                      Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  events                   ApplicationEvent[]

  // One application per candidate per job; also serves lookups by candidate.
  @@unique([candidateId, jobId])
  @@index([jobId, status])
  @@index([jobId, submittedAt])
  @@index([status])
  @@index([createdAt])
  @@map("job_applications")
}

/// History of an application: each status or interview change, who made it and when.
model ApplicationEvent {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @map("application_id")
  // status | interview
  field         String         @db.VarChar(20)
  fromValue     String?        @map("from_value") @db.VarChar(20)
  toValue       String         @map("to_value") @db.VarChar(20)
  note          String?        @db.Text
  // Null for automatic changes (e.g. cancelled because hired elsewhere) or a deleted user.
  actorId       String?        @map("actor_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([actorId])
  @@map("application_events")
}

model SiteSetting {
  id                 Int      @id @default(1)
  siteName           String   @default("Workbuckle") @map("site_name") @db.VarChar(120)
  contactEmail       String?  @map("contact_email") @db.VarChar(255)
  contactPhone       String?  @map("contact_phone") @db.VarChar(40)
  logoUrl            String?  @map("logo_url") @db.VarChar(2048)
  faviconUrl         String?  @map("favicon_url") @db.VarChar(2048)
  metaTitle          String?  @map("meta_title") @db.VarChar(120)
  metaDescription    String?  @map("meta_description") @db.VarChar(320)
  facebookUrl        String?  @map("facebook_url") @db.VarChar(2048)
  linkedinUrl        String?  @map("linkedin_url") @db.VarChar(2048)
  instagramUrl       String?  @map("instagram_url") @db.VarChar(2048)
  about              String?
  maintenanceMode    Boolean  @default(false) @map("maintenance_mode")
  maintenanceMessage String?  @map("maintenance_message")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

// USER = no panel access (also the default for OAuth sign-ups).
// ADMIN = full access. EMPLOYER and VIEWER are read-only; see lib/auth/roles.ts.
enum Role {
  USER
  ADMIN
  EMPLOYER
  VIEWER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// Panel-wide alerts (e.g. a new job application). Polled by
// app/api/admin/notifications/stream and shown in the admin bell + toasts.
model AdminNotification {
  id        String           @id @default(uuid()) @db.Uuid
  title     String           @db.VarChar(200)
  message   String           @db.Text
  type      NotificationType @default(INFO)
  // Admin path to open from the toast/bell, e.g. /admin/candidates/<id>.
  link      String?          @db.VarChar(2048)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  // The stream reads WHERE is_read = false ORDER BY created_at DESC.
  @@index([isRead, createdAt(sort: Desc)])
  @@map("admin_notifications")
}

// Shared rate-limit counters (lib/rate-limit.ts), so every server instance sees
// the same counts and a restart doesn't reset them. `key` is a SHA-256 of the
// limiter name plus the client key, so no email or IP address is stored.
model RateLimit {
  key     String   @id @db.VarChar(64)
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  // Expired windows are swept by reset_at.
  @@index([resetAt])
  @@map("rate_limits")
}
